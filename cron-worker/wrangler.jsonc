// Worker só de agendamento: chama as rotinas do Worker principal ("tipe")
// por service binding, sem passar pela internet.
// Segredo: `npx wrangler secret put CRON_SECRET --config cron-worker/wrangler.jsonc`
// (o mesmo valor configurado no Worker principal).
{
  "name": "tipe-cron",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "services": [{ "binding": "APP", "service": "tipe" }],
  "triggers": { "crons": ["* * * * *", "*/5 * * * *"] }
}
