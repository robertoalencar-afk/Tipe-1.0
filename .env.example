# Copie para .env para rodar localmente (bun run dev). Nunca versione o .env.

# Públicas (vão para o navegador; no deploy ficam em GitHub > Settings > Variables)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=SEU-PROJETO

# Servidor (no deploy ficam como segredos do Worker; veja docs/deploy/README.md)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
ANTHROPIC_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=noreply@tipe.digital
CRON_SECRET=
TIPE_ENCRYPTION_KEY=
PAGARME_SECRET_KEY=
PAGARME_PUBLIC_KEY=
PAGARME_WEBHOOK_SECRET=
PAGARME_TIPE_RECIPIENT_ID=
TIPE_PLATFORM_FEE_PERCENT=
# Transcrição de áudio da Lebre (Workers AI)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
# Google Pay em produção (emitido pelo Google após aprovar a integração). Sem ele, só ambiente TEST.
GOOGLE_PAY_MERCHANT_ID=

# Só para scripts/db (migrações e empresas de teste)
DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres
