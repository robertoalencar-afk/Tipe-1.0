{
  "expo": {
    "name": "Tipe Guest",
    "slug": "tipe-guest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tipeguest",
    "userInterfaceStyle": "light",
    "primaryColor": "#021E34",
    "description": "Reserve mesa, entre na fila na porta e pague a conta com o Tipe.",
    "ios": {
      "bundleIdentifier": "digital.tipe.guest",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": { "usesNonExemptEncryption": false },
      "infoPlist": {
        "NSCameraUsageDescription": "A câmera lê o QR da porta do restaurante para você entrar na fila.",
        "NSLocationWhenInUseUsageDescription": "Usamos sua localização uma vez, na porta do restaurante, para confirmar que você está lá antes de entrar na fila."
      }
    },
    "android": {
      "package": "digital.tipe.guest",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#021E34",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA", "android.permission.ACCESS_COARSE_LOCATION", "android.permission.ACCESS_FINE_LOCATION"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#021E34",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        { "cameraPermission": "A câmera lê o QR da porta do restaurante para você entrar na fila." }
      ],
      [
        "expo-location",
        { "locationWhenInUsePermission": "Usamos sua localização uma vez, na porta do restaurante, para confirmar que você está lá antes de entrar na fila." }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
